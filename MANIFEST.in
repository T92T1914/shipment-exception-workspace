include LICENSE SECURITY.md THIRD_PARTY_NOTICES.txt requirements-lock.txt
include frontend/package.json frontend/package-lock.json frontend/index.html
include frontend/tsconfig.json frontend/vite.config.ts frontend/playwright.config.ts
recursive-include frontend/src *.ts *.tsx *.css
recursive-include frontend/e2e *.ts
recursive-include tools *.py
include tools/restored_browser.cjs
include tools/public_demo_browser.cjs
include tools/requirements-presentation.txt
include docs/workflow-explainer.json docs/workflow-rendering.json
include docs/assets/workflow-obscur-wide.svg docs/assets/workflow-obscur-narrow.svg
recursive-include site *.html *.css *.js
recursive-include deploy *.py
include deploy/environment.example
recursive-include tests *.py *.sql
recursive-include docs *.md *.png
